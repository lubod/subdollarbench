# Copy to .env (0600). Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional management key for per-run capped keys (bounds blast radius).
OPENROUTER_MGMT_KEY=
# Required when binding --host 0.0.0.0 or exposing the UI beyond loopback.
SDB_UI_TOKEN=change-me-to-32-random-chars
# Optional login (both must be set to enable).
SDB_UI_USER=
SDB_UI_PASS=
# Workers 1..8 (default 4). Higher = faster waves, noisier throughput refs.
SDB_WORKERS=4
# Egress filter: 1 = --internal run network + allowlist proxy (production).
SDB_EGRESS_FILTER=0
