FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install base dependencies and build toolchains
RUN apt-get update && apt-get install -y --no-install-recommends     build-essential     clang     cmake     curl     dnsutils     git     golang-go     iproute2     netcat-openbsd     nodejs     npm     procps     python3     python3-dev     python3-pip     redis-tools     sudo     unzip     wrk     ca-certificates     && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash &&     cp /root/.bun/bin/bun /usr/local/bin/bun

# Ubuntu 24.04 already has user 'ubuntu' (UID 1000)
RUN echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install Rust toolchain for ubuntu user
USER ubuntu
ENV HOME=/home/ubuntu
ENV PATH="/home/ubuntu/.cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

# Prepare workspace
WORKDIR /workspace
USER root
RUN chown -R ubuntu:ubuntu /workspace

# Install OMP (Oh My Pi agent harness)
ARG OMP_VERSION=18.4.2
RUN npm install -g @oh-my-pi/pi-coding-agent@${OMP_VERSION}

USER ubuntu

CMD ["/bin/bash"]
