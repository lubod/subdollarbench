FROM ubuntu:24.04

# R33: CI passes the runner's UID/GID so the mounted workspace is writable
# by the sandbox user. The defaults keep the bench image unchanged.
ARG SANDBOX_UID=1000
ARG SANDBOX_GID=1000

# R81 F1: the sandbox is Rust-only. The toolchain is pinned twice: the
# rustup-init download by version and SHA-256 (read from
# https://static.rust-lang.org/rustup/archive/1.29.3/x86_64-unknown-linux-gnu/rustup-init.sha256
# on 2026-11-13), and the toolchain by version (the current stable on
# 2026-11-13, https://static.rust-lang.org/dist/channel-rust-stable.toml).
# llvm-tools-preview carries llvm-profdata/llvm-cov for F4's coverage.
ARG RUSTUP_VERSION=1.29.3
ARG RUSTUP_INIT_SHA256=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
ARG RUST_VERSION=1.100.0

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install base dependencies and the Rust linker. R81 F1 removes the other
# language toolchains: the .47 candidate is Rust, standard library only.
# python3 and node stay for test scripts and the agent harnesses;
# build-essential stays because the Rust linker uses gcc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    dnsutils \
    git \
    iproute2 \
    netcat-openbsd \
    nodejs \
    npm \
    procps \
    python3 \
    redis-tools \
    sudo \
    unzip \
    wrk \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# R81 F1: omp 18.18.3 is a Bun script (`#!/usr/bin/env bun`), so the
# acceptance's "omp runs" needs a Bun runtime even though Bun is not a
# candidate toolchain. Install it as omp's private runtime at
# /opt/omp-runtime, never on PATH: `command -v bun` is absent, and the
# Rust listener rule rejects any non-rustc server anyway. Pinned to the
# version the .46 image shipped (1.4.4); curl retries the whole download
# (R68 F4: a single HTTP 504 must not fail CI).
ARG BUN_VERSION=1.4.4
RUN curl -fsSL --retry 5 --retry-all-errors https://bun.sh/install \
        | BUN_INSTALL=/opt/omp-runtime bash -s "bun-v${BUN_VERSION}" \
    && /opt/omp-runtime/bin/bun --version

# Ubuntu 24.04 already has user 'ubuntu' (UID 1000)
RUN echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install the pinned Rust toolchain for the ubuntu user.
USER ubuntu
ENV HOME=/home/ubuntu
ENV RUSTUP_HOME=/home/ubuntu/.rustup
ENV CARGO_HOME=/home/ubuntu/.cargo
ENV PATH="/home/ubuntu/.cargo/bin:${PATH}"
RUN curl -fsSL --retry 5 --retry-all-errors \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
        -o /tmp/rustup-init \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_VERSION}" \
        --component llvm-tools-preview \
    && rm -f /tmp/rustup-init

# R81 F1: no registry can be reached. CARGO_NET_OFFLINE makes every cargo
# command offline; the empty directory source replaces crates.io so even a
# command without --offline fails fast on the first dependency.
ENV CARGO_NET_OFFLINE=true
RUN mkdir -p "${CARGO_HOME}/offline-registry" \
    && printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "sdb-offline"' \
        '' \
        '[source.sdb-offline]' \
        'directory = "/home/ubuntu/.cargo/offline-registry"' \
        > "${CARGO_HOME}/config.toml"

# Prepare workspace
WORKDIR /workspace
USER root
RUN chown -R ubuntu:ubuntu /workspace \
    && if [ "$SANDBOX_GID" != "1000" ]; then groupmod -g "$SANDBOX_GID" ubuntu; fi \
    && if [ "$SANDBOX_UID" != "1000" ]; then usermod -u "$SANDBOX_UID" ubuntu; fi \
    && if [ "$SANDBOX_UID" != "1000" ] || [ "$SANDBOX_GID" != "1000" ]; then \
         chown -R ubuntu:ubuntu /home/ubuntu /workspace; \
       fi

# Install OMP (Oh My Pi agent harness). Its npm bin is a Bun script;
# replace the symlink with a wrapper that runs it through the private
# runtime above, so `bun` stays off the candidate's PATH.
ARG OMP_VERSION=18.18.3
RUN npm install -g @oh-my-pi/pi-coding-agent@${OMP_VERSION} \
    && rm -f /usr/local/bin/omp \
    && printf '#!/bin/sh\nexec /opt/omp-runtime/bin/bun /usr/local/lib/node_modules/@oh-my-pi/pi-coding-agent/dist/cli.js "$@"\n' \
        > /usr/local/bin/omp \
    && chmod 755 /usr/local/bin/omp

# Install OpenCode CLI (second agent harness, pinned — must match
# OPENCODE_VERSION in src/sandbox/opencode.rs; bump together).
# Same npm distribution as the host binary (@opencode/cli).
ARG OPENCODE_VERSION=2.0.24
RUN npm install -g @opencode/cli@${OPENCODE_VERSION} \
    && chown -R ubuntu:ubuntu /home/ubuntu/.config /home/ubuntu/.local /home/ubuntu/.npm /home/ubuntu/.cache 2>/dev/null; true
USER ubuntu
RUN opencode --version

CMD ["/bin/bash"]
